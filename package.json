{
  "name": "drunkdrive-th",
  "private": true,
  "version": "0.1.0",
  "description": "ระบบรวมข่าวอุบัติเหตุเมาแล้วขับและด่านตรวจแอลกอฮอล์ในประเทศไทย",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "ingest": "tsx src/backend/ingest/cli.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accuracy": "vitest run tests/casualty-accuracy.spec.ts --reporter=verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.74.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.6",
    "string-similarity-js": "^2.1.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
